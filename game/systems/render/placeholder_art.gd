class_name PlaceholderArt
extends RefCounted
## Bakes every sprite of the game (units with 6 poses, buildings, resource
## nodes, HUD icons) into ONE atlas texture at startup with the original
## painters in systems/render/. One texture means the renderer batches the
## whole map into a handful of draw calls. (The name is historical: since
## F9 this is the game's real art, generated by code, no external assets.)
##
## A white 4x4 block at the atlas origin is used for tinted bars (HP, progress).
##
## Painting everything takes seconds, so the atlas is baked ahead of time by
## `tests/tools/bake_art.tscn` into assets/art/ (like tools/gen_audio.py for
## sound) and the game just loads it. If the data changed since the bake
## (its fingerprint differs) the game paints the atlas at startup instead.

## Bump when a painter changes, so an old baked atlas is not used.
const ART_VERSION: int = 8
const BAKED_PNG: String = "res://assets/art/atlas.png"
const BAKED_JSON: String = "res://assets/art/atlas.json"
const ATLAS_WIDTH: int = 2048
const WHITE_RECT: Rect2 = Rect2(1, 1, 2, 2)
const POSES: PackedStringArray = ["idle", "walk0", "walk1", "attack0", "attack1", "dead"]

static var _texture: Texture2D = null
static var _regions: Dictionary = {}


## Variant key for a player (0, 1, ...) or "gaia" for neutral things.
static func variant_key(owner_id: int) -> String:
	return "gaia" if owner_id < 0 else "p%d" % owner_id


static func texture() -> Texture2D:
	if _texture == null:
		load_or_build()
	return _texture


## Uses the baked atlas when it matches the current data, else paints it.
static func load_or_build() -> void:
	if _load_baked():
		return
	build()


## True if the baked atlas exists and was made from the same data and painters.
static func baked_is_fresh() -> bool:
	if not FileAccess.file_exists(BAKED_JSON) or not ResourceLoader.exists(BAKED_PNG):
		return false
	var meta: Variant = JSON.parse_string(FileAccess.get_file_as_string(BAKED_JSON))
	return meta is Dictionary and String((meta as Dictionary).get("fingerprint", "")) == fingerprint()


## Hash of everything the painters read: unit/building/resource tables,
## player colours, tile size and ART_VERSION.
static func fingerprint() -> String:
	var parts: Array = [ART_VERSION, DataLoader.rule("players", "colors", []), DataLoader.get_table("terrain").get("tile_size", 64)]
	for table: String in ["units", "buildings", "resources"]:
		var t: Dictionary = DataLoader.get_table(table)
		var keys: Array = t.keys()
		keys.sort()
		for k: String in keys:
			var e: Dictionary = t[k]
			parts.append([k, e.get("footprint", []), e.get("color", ""), e.has("animal")])
	return str(hash(JSON.stringify(parts)))


static func _load_baked() -> bool:
	if not baked_is_fresh():
		return false
	var meta: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(BAKED_JSON))
	var tex: Texture2D = load(BAKED_PNG)
	if tex == null:
		return false
	_regions.clear()
	var regions: Dictionary = meta.get("regions", {})
	for key: String in regions.keys():
		var r: Array = regions[key]
		_regions[key] = Rect2(float(r[0]), float(r[1]), float(r[2]), float(r[3]))
	_texture = tex
	return true


## Paints the atlas and writes it as PNG + JSON (regions and fingerprint).
static func bake(dir: String) -> Error:
	build()
	DirAccess.make_dir_recursive_absolute(dir)
	var err: Error = _texture.get_image().save_png(dir.path_join("atlas.png"))
	if err != OK:
		return err
	var regions: Dictionary = {}
	for key: String in _regions.keys():
		var r: Rect2 = _regions[key]
		regions[key] = [r.position.x, r.position.y, r.size.x, r.size.y]
	var f: FileAccess = FileAccess.open(dir.path_join("atlas.json"), FileAccess.WRITE)
	if f == null:
		return FileAccess.get_open_error()
	f.store_string(JSON.stringify({"fingerprint": fingerprint(), "art_version": ART_VERSION, "regions": regions}, "\t", true))
	return OK


static func unit_region(type_id: String, owner_id: int) -> Rect2:
	return unit_frame(type_id, owner_id, "idle")


static func unit_frame(type_id: String, owner_id: int, pose: String) -> Rect2:
	var r: Rect2 = region("unit:%s@%s#%s" % [type_id, variant_key(owner_id), pose])
	if r.size == Vector2.ZERO:
		r = region("unit:%s@%s#idle" % [type_id, variant_key(owner_id)])
	return r


## `era` > 0 picks an era look when the building has one (Town Center).
static func building_region(type_id: String, owner_id: int, era: int = 0) -> Rect2:
	if era > 0:
		var r: Rect2 = region("bldg:%s@%s#e%d" % [type_id, variant_key(owner_id), era])
		if r.size != Vector2.ZERO:
			return r
	return region("bldg:%s@%s" % [type_id, variant_key(owner_id)])


static func resource_region(type_id: String) -> Rect2:
	return region("res:" + type_id)


## White elliptical ring (tinted when drawn): unit selection on the ground.
## Drawing it from the atlas keeps selected units in the same batch.
static func ring_region() -> Rect2:
	return region("fx:ring")


static func icon_region(resource: String) -> Rect2:
	return region("icon:" + resource)


## An AtlasTexture for UI controls (HUD icons).
static func icon_texture(resource: String) -> AtlasTexture:
	var t: AtlasTexture = AtlasTexture.new()
	t.atlas = texture()
	t.region = icon_region(resource)
	return t


static func region(key: String) -> Rect2:
	if _texture == null:
		load_or_build()
	return _regions.get(key, Rect2())


## (Re)builds the atlas from the data tables. Safe to call again after data reloads.
static func build() -> void:
	var t0: int = Time.get_ticks_msec()
	var images: Dictionary = {}
	var colors: Array = DataLoader.rule("players", "colors", ["#3a6fd8", "#d84a3a"])
	var tile: int = int(DataLoader.get_table("terrain").get("tile_size", 64))

	var units: Dictionary = DataLoader.get_table("units")
	for type_id: String in units.keys():
		var entry: Dictionary = units[type_id]
		var variants: Dictionary = {}
		if entry.has("animal"):
			variants["gaia"] = Color(0.5, 0.5, 0.5)
		for i: int in colors.size():
			variants["p%d" % i] = Color.html(String(colors[i]))
		for v: String in variants.keys():
			for pose: String in POSES:
				images["unit:%s@%s#%s" % [type_id, v, pose]] = UnitPainter.paint(type_id, variants[v], pose)

	var buildings: Dictionary = DataLoader.get_table("buildings")
	for type_id: String in buildings.keys():
		var fp: Array = Dictionary(buildings[type_id]).get("footprint", [2, 2])
		var size: Vector2i = Vector2i(int(fp[0]) * tile, int(fp[1]) * tile)
		for i: int in colors.size():
			images["bldg:%s@p%d" % [type_id, i]] = BuildingPainter.paint(type_id, size, Color.html(String(colors[i])))
			if type_id == "town_center":
				for era: int in [2, 3, 4]:
					images["bldg:%s@p%d#e%d" % [type_id, i, era]] = BuildingPainter.paint(type_id, size, Color.html(String(colors[i])), era)
			if type_id == "gate":
				images["bldg:gate_open@p%d" % i] = BuildingPainter.paint("gate_open", size, Color.html(String(colors[i])))

	var resources: Dictionary = DataLoader.get_table("resources")
	for type_id: String in resources.keys():
		var r: Dictionary = resources[type_id]
		if not r.has("color"):
			continue
		var rfp: Array = r.get("footprint", [1, 1])
		# "art": paint like another type (a rich gold vein looks like a gold mine).
		images["res:" + type_id] = NaturePainter.resource(String(r.get("art", type_id)), Vector2i(int(rfp[0]) * tile, int(rfp[1]) * tile), Color.html(String(r.get("color", "#cccccc"))))

	for res: String in ["food", "wood", "gold", "stone"]:
		images["icon:" + res] = NaturePainter.icon(res)
	images["fx:ring"] = _ring_image(Vector2i(96, 48), 5.0)

	_pack(images)
	if OS.is_debug_build():
		print("[REALM] atlas built in %d ms (%d sprites)" % [Time.get_ticks_msec() - t0, images.size()])


## Anti-aliased white ring along an ellipse that fills `size`.
static func _ring_image(size: Vector2i, thickness: float) -> Image:
	var img: Image = Image.create(size.x, size.y, false, Image.FORMAT_RGBA8)
	img.fill(Color(1, 1, 1, 0))
	var c: Vector2 = Vector2(size) * 0.5
	var r: Vector2 = c - Vector2(thickness, thickness) * 0.5 - Vector2.ONE
	for y: int in size.y:
		for x: int in size.x:
			var pv: Vector2 = Vector2(x + 0.5, y + 0.5) - c
			var k: float = (pv / r).length()
			if k <= 0.0:
				continue
			# Pixel distance to the ellipse along the ray from the centre.
			var dist: float = absf(pv.length() * (1.0 - 1.0 / k))
			var a: float = clampf(thickness * 0.5 + 0.5 - dist, 0.0, 1.0)
			if a > 0.0:
				img.set_pixel(x, y, Color(1, 1, 1, a))
	return img


## Shelf packing: sort by height, fill rows left to right.
static func _pack(images: Dictionary) -> void:
	var keys: Array = images.keys()
	keys.sort_custom(func(a: String, b: String) -> bool:
		return (images[a] as Image).get_height() > (images[b] as Image).get_height())
	var placements: Dictionary = {}
	var x: int = 8
	var y: int = 0
	var row_h: int = 8
	for key: String in keys:
		var img: Image = images[key]
		if x + img.get_width() > ATLAS_WIDTH:
			x = 0
			y += row_h
			row_h = 0
		placements[key] = Vector2i(x, y)
		x += img.get_width()
		row_h = maxi(row_h, img.get_height())
	var height: int = int(nearest_po2(maxi(16, y + row_h)))
	var atlas: Image = Image.create(ATLAS_WIDTH, height, false, Image.FORMAT_RGBA8)
	atlas.fill(Color(0, 0, 0, 0))
	atlas.fill_rect(Rect2i(0, 0, 4, 4), Color.WHITE)
	_regions.clear()
	for key: String in keys:
		var img: Image = images[key]
		var at: Vector2i = placements[key]
		atlas.blit_rect(img, Rect2i(Vector2i.ZERO, img.get_size()), at)
		_regions[key] = Rect2(at, img.get_size())
	_texture = ImageTexture.create_from_image(atlas)
